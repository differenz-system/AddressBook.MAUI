<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AddressBook.MAUI.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Services="clr-namespace:AddressBook.MAUI.Services"
    xmlns:behaviors="clr-namespace:AddressBook.MAUI.Behavior"
    xmlns:customControls="clr-namespace:AddressBook.MAUI.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:resources="clr-namespace:AddressBook.MAUI.LanguageResources"
    xmlns:viewmodel="clr-namespace:AddressBook.MAUI.ViewModels"
    ios:Page.UseSafeArea="False"
    ControlTemplate="{StaticResource HeaderTemplate}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Content>
        <ScrollView
            BackgroundColor="{x:AppThemeBinding Dark={StaticResource BlackColor},
                                                Light={StaticResource WhiteColor}}"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand">
            <StackLayout
                x:Name="mainStackView"
                Padding="{Static Services:LayoutService.MarginPadding50}"
                Spacing="{Static Services:LayoutService.Spacing20}"
                VerticalOptions="FillAndExpand">
                <Label
                    HorizontalOptions="Start"
                    Style="{StaticResource Size16BlackBoldLabelStyle}"
                    Text="{x:Static resources:AppResources.TEXT_EMAIL}" />
                <customControls:CustomEntry
                    HorizontalOptions="FillAndExpand"
                    Keyboard="Email"
                    Placeholder="{x:Static resources:AppResources.PLACEHOLDER_EMAIL}"
                    Text="{Binding Email}">
                    <customControls:CustomEntry.Behaviors>
                        <behaviors:AnimateSizeBehavior />
                    </customControls:CustomEntry.Behaviors>
                    <customControls:CustomEntry.Shadow>
                        <Shadow
                            Brush="{StaticResource DarkBlueColor}"
                            Opacity="0.3"
                            Radius="5"
                            Offset="0,10" />
                    </customControls:CustomEntry.Shadow>
                </customControls:CustomEntry>
                <Label
                    HorizontalOptions="Start"
                    Style="{StaticResource Size16BlackBoldLabelStyle}"
                    Text="{x:Static resources:AppResources.TEXT_PASSWORD}" />
                <customControls:CustomEntry
                    HorizontalOptions="FillAndExpand"
                    IsPassword="true"
                    Placeholder="{x:Static resources:AppResources.PLACEHOLDER_PASSWORD}"
                    Text="{Binding Password}">
                    <customControls:CustomEntry.Behaviors>
                        <behaviors:AnimateSizeBehavior />
                    </customControls:CustomEntry.Behaviors>
                    <customControls:CustomEntry.Shadow>
                        <Shadow
                            Brush="{StaticResource DarkBlueColor}"
                            Opacity="0.3"
                            Radius="5"
                            Offset="0,10" />
                    </customControls:CustomEntry.Shadow>
                </customControls:CustomEntry>
                <Border
                    Margin="{Static Services:LayoutService.MarginPadding00_30_00_00}"
                    Padding="0"
                    HeightRequest="{Static Services:LayoutService.HeightWidth50}"
                    StrokeThickness="0">
                    <Button
                        BorderColor="Transparent"
                        BorderWidth="0"
                        Command="{Binding LoginCommand}"
                        HorizontalOptions="FillAndExpand"
                        Text="{x:Static resources:AppResources.TEXT_LOG_IN}" />
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="25, 25, 25, 25" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow
                            Brush="{StaticResource DarkBlueColor}"
                            Opacity="0.5"
                            Radius="5"
                            Offset="0,10" />
                    </Border.Shadow>
                </Border>
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
